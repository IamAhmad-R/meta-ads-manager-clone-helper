{
  "manifest_version": 3,
  "name": "Meta Ads Manager Clone Helper",
  "version": "1.5.1",
  "description": "Clean-room Chrome extension for bulk creative-enhancement opt-outs, preview and post-ID export, carousel placement conversion and ad duplication in Meta Ads Manager.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "tabs",
    "webRequest",
    "offscreen",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://*.facebook.com/*",
    "https://graph.facebook.com/*"
  ],
  "action": {
    "default_popup": "ui/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.facebook.com/*"
      ],
      "js": [
        "src/sidebar.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "ui/*",
        "icons/*"
      ],
      "matches": [
        "https://*.facebook.com/*"
      ]
    }
  ],
  "options_page": "ui/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
